rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- 1. FUNÇÕES AUXILIARES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profile;
    }

    function isApproved() {
      return isSignedIn() && getUserProfile().status == 'aprovado';
    }

    function isAdmin() {
      return isApproved() && getUserProfile().role == 'admin';
    }

    function isFuncionario() {
      return isApproved() && getUserProfile().role == 'funcionario';
    }

    function isProfissional() {
      return isApproved() && getUserProfile().role == 'profissional';
    }

    function isCoordenador() {
      return isApproved() && getUserProfile().role == 'coordenador';
    }

    function isFamiliar() {
      return isApproved() && getUserProfile().role == 'familiar';
    }

    function isAdminOrCoordinator() {
      return isAdmin() || isCoordenador();
    }

    function canManage() {
      return isAdmin() || isCoordenador() || isFuncionario();
    }

    function canAccessPatientObservations() {
      return canManage() || isProfissional();
    }

    function isComercialTeam() {
      return isAdmin() || isCoordenador();
    }

    // Lançamento de repasse ao profissional, gerado ao finalizar um atendimento
    function isRepasse(dados) {
      return dados.category == 'Repasse de Profissional';
    }

    // O atendimento é desta criança, não foi cancelado e é de quem está escrevendo (pelo cadastro
    // de profissional ligado à conta). É a prova de que o terapeuta atende a criança.
    function ehSessaoMinhaCom(atendimentoId, patientId) {
      let sessao = get(/databases/$(database)/documents/appointments/$(atendimentoId)).data;
      return sessao.patientId == patientId && sessao.status != 'cancelado'
        && get(/databases/$(database)/documents/professionals/$(sessao.professionalId)).data.userId == request.auth.uid;
    }

    // A marca da evolução na sessão da agenda tem que bater com a evolução gravada junto:
    // "escrita" com evolução que aconteceu, "nao_aconteceu" com a que não, e sem marca sem evolução
    function marcaBateComEvolucao(atendimentoId, patientId) {
      let caminho = /databases/$(database)/documents/patients/$(patientId)/evolucoes/$(atendimentoId);
      let marca = request.resource.data.get('evolucao', null);
      return (marca == null && !existsAfter(caminho))
        || (marca == 'escrita' && existsAfter(caminho) && getAfter(caminho).data.aconteceu == true)
        || (marca == 'nao_aconteceu' && existsAfter(caminho) && getAfter(caminho).data.aconteceu == false);
    }

    // A evolução é um texto só ("O que aconteceu na sessão"), como no papel
    function textoDaEvolucao(dados) {
      return dados.texto is string && dados.texto.size() <= 8000 && dados.aconteceu is bool;
    }

    function textoDaAnotacao(dados) {
      return dados.texto is string && dados.texto.size() > 0 && dados.texto.size() <= 8000 && dados.fixada is bool;
    }

    // --- 2. REGRAS DE USUÁRIOS ---
    match /users/{userId} {
      // O próprio cadastro sempre nasce pendente e com um dos papéis do formulário:
      // quem aprova e quem dá papel de admin ou coordenação é o admin
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.profile.status == 'pendente'
        && request.resource.data.profile.role in ['familiar', 'profissional', 'funcionario'];
      // Cada pessoa lê o próprio cadastro, mesmo pendente: é assim que o login avisa que falta aprovação.
      // Os cadastros dos outros (CPF, e-mail, telefone) só a gestão vê.
      allow read: if (isSignedIn() && request.auth.uid == userId) || canManage();
      // O admin altera tudo. A própria pessoa só troca o nome (tela "Minha conta").
      allow update: if isAdmin() || (
        request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 120
      );
      allow delete: if isAdmin();
    }

    // --- 3. REGRAS DE CHAT ---
    match /chat_groups/{groupId} {
      // Prévia da conversa gravada junto com a mensagem que o próprio membro enviou
      function isOwnPreview() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt'])
          && request.resource.data.lastMessage.keys().hasOnly(['content', 'senderId', 'senderName', 'createdAt'])
          && request.resource.data.lastMessage.content is string
          && request.resource.data.lastMessage.content.size() > 0
          && request.resource.data.lastMessage.content.size() <= 2000
          && request.resource.data.lastMessage.senderId == request.auth.uid
          && request.resource.data.lastMessage.senderName
            == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
          && request.resource.data.lastMessage.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
      }

      // "Li até aqui": cada um grava só o próprio registro, com o horário do servidor
      function isOwnReadMark() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadAt'])
          && request.resource.data.lastReadAt.diff(resource.data.get('lastReadAt', {})).affectedKeys()
            .hasOnly([request.auth.uid])
          && request.resource.data.lastReadAt[request.auth.uid] == request.time;
      }

      // O que só a coordenação muda: quem participa (com nome e papel) e a qual criança o grupo pertence
      function isGroupManagement() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberIds', 'membros', 'pacienteId', 'pacienteNome']);
      }

      // Só quem tem cadastro aprovado: pendentes e usuários removidos perdem o acesso
      allow read: if isApproved() && (
        request.auth.uid in resource.data.memberIds || isAdminOrCoordinator()
      );
      allow create: if isSignedIn() && isAdminOrCoordinator() && request.resource.data.createdBy == request.auth.uid;
      // Quem acessa a conversa (membro ou supervisão) grava só a prévia da própria mensagem
      // ou a própria leitura; a coordenação também muda participantes e a criança do grupo.
      allow update: if isApproved() && (
        (isAdminOrCoordinator() && isGroupManagement())
        || (
          (request.auth.uid in resource.data.memberIds || isAdminOrCoordinator())
          && (isOwnPreview() || isOwnReadMark())
        )
      );
    }

    match /chat_groups/{groupId}/messages/{messageId} {
      function canAccessChat() {
        return isApproved() && (
          request.auth.uid in get(/databases/$(database)/documents/chat_groups/$(groupId)).data.memberIds
          || isAdminOrCoordinator()
        );
      }

      allow read: if canAccessChat();

      allow create: if canAccessChat()
        && request.resource.data.keys().hasAll([
          'senderId', 'senderName', 'senderRole', 'content', 'type', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'senderId', 'senderName', 'senderRole', 'content', 'type', 'createdAt'
        ])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderName
          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        && request.resource.data.senderRole == getUserProfile().role
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000
        && request.resource.data.type == 'text'
        && request.resource.data.createdAt == request.time;

      // Mensagens não podem ser editadas nem apagadas.
      allow update, delete: if false;
    }

    // --- 4. OUTRAS REGRAS DO SISTEMA ---

    // --- PACIENTES (Lógica de Auto-Vínculo Atualizada) ---
    match /patients/{patientId} {
      // Gestão e terapeutas veem todas as crianças. A família vê só as suas: as já ligadas a ela
      // e, para o primeiro vínculo, as cadastradas com o e-mail dela.
      allow read: if canManage() || isProfissional() || (
        isFamiliar() && (
          resource.data.userId == request.auth.uid
          || resource.data.emailCadastro == request.auth.token.email
        )
      );

      // Create e Delete continuam restritos APENAS à gestão
      allow create, delete: if canManage();

      // Update: gestão, ou o vínculo automático da família já aprovada com a criança do e-mail dela
      allow update: if canManage() || (
        isFamiliar() &&
        resource.data.emailCadastro == request.auth.token.email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId']) &&
        request.resource.data.userId == request.auth.uid
      );

      // Histórico clínico separado do documento principal do paciente.
      // Familiares não têm acesso a esta subcoleção.
      match /observations/{observationId} {
        allow read: if canAccessPatientObservations();

        allow create: if canAccessPatientObservations()
          && exists(/databases/$(database)/documents/patients/$(patientId))
          && request.resource.data.keys().hasAll([
            'texto',
            'criadoEm',
            'autorId',
            'autorNome',
            'autorPerfil'
          ])
          && request.resource.data.keys().hasOnly([
            'texto',
            'criadoEm',
            'autorId',
            'autorNome',
            'autorPerfil'
          ])
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 2000
          && request.resource.data.autorId == request.auth.uid
          && request.resource.data.autorNome
            == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
          && request.resource.data.autorPerfil == getUserProfile().role
          && request.resource.data.criadoEm == request.time;

        // Observações não podem ser editadas. O autor pode excluir a própria
        // observação; administradores e coordenadores podem excluir qualquer uma.
        allow update: if false;
        allow delete: if canAccessPatientObservations() && (
          isAdminOrCoordinator() ||
          resource.data.autorId == request.auth.uid
        );
      }

      // Quem atende a criança: um documento por terapeuta, com uma sessão dele com ela como prova.
      // O próprio terapeuta entra ao escrever a primeira evolução ou ao abrir a história da criança.
      match /equipe/{uid} {
        allow read: if isAdminOrCoordinator() || (isApproved() && request.auth.uid == uid);
        allow create, update: if isApproved() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['atendimentoId', 'criadoEm'])
          && ehSessaoMinhaCom(request.resource.data.atendimentoId, patientId);
        allow delete: if isAdmin();
      }

      // Evoluções diárias (lib/evolucoes.ts): uma por sessão, com o id do atendimento. São dados de
      // saúde: leem o admin, a coordenação e os terapeutas da equipe da criança. A recepção e a
      // família não. Só o terapeuta da sessão escreve, e só quem escreveu corrige.
      match /evolucoes/{atendimentoId} {
        allow read: if isAdminOrCoordinator() || (
          isApproved() && exists(/databases/$(database)/documents/patients/$(patientId)/equipe/$(request.auth.uid))
        );

        allow create: if isApproved()
          && request.resource.data.keys().hasOnly([
            'appointmentId', 'patientId', 'patientName', 'professionalId', 'professionalName', 'terapia',
            'dataDaSessao', 'autorId', 'autorNome', 'aconteceu', 'texto', 'criadoEm'
          ])
          && request.resource.data.appointmentId == atendimentoId
          && request.resource.data.patientId == patientId
          && request.resource.data.autorId == request.auth.uid
          && request.resource.data.criadoEm == request.time
          && ehSessaoMinhaCom(atendimentoId, patientId)
          && request.resource.data.professionalId == get(/databases/$(database)/documents/appointments/$(atendimentoId)).data.professionalId
          && request.resource.data.dataDaSessao == get(/databases/$(database)/documents/appointments/$(atendimentoId)).data.start
          && textoDaEvolucao(request.resource.data);

        // Corrigir: só o texto e se aconteceu, por quem escreveu; fica a marca de editada
        allow update: if isApproved() && resource.data.autorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['aconteceu', 'texto', 'editadoEm'])
          && request.resource.data.editadoEm == request.time
          && textoDaEvolucao(request.resource.data);

        allow delete: if isAdminOrCoordinator() || (isApproved() && resource.data.autorId == request.auth.uid);
      }

      // Anotações do prontuário: o que vale para toda a terapia da criança (objetivos, o que funciona,
      // o que evitar). Leem como as evoluções. Cada terapeuta escreve só na terapia dele, provando com
      // uma sessão sua com a criança daquela terapia. Só quem escreveu corrige; ninguém apaga.
      match /anotacoes/{anotacaoId} {
        allow read: if isAdminOrCoordinator() || (
          isApproved() && exists(/databases/$(database)/documents/patients/$(patientId)/equipe/$(request.auth.uid))
        );

        allow create: if isApproved()
          && request.resource.data.keys().hasOnly(['terapia', 'texto', 'fixada', 'autorId', 'autorNome', 'atendimentoId', 'criadoEm'])
          && request.resource.data.keys().hasAll(['terapia', 'texto', 'fixada', 'autorId', 'autorNome', 'atendimentoId', 'criadoEm'])
          && request.resource.data.autorId == request.auth.uid
          && request.resource.data.autorNome is string
          && request.resource.data.criadoEm == request.time
          && textoDaAnotacao(request.resource.data)
          && ehSessaoMinhaCom(request.resource.data.atendimentoId, patientId)
          && request.resource.data.terapia == get(/databases/$(database)/documents/appointments/$(request.resource.data.atendimentoId)).data.tipo;

        allow update: if isApproved() && resource.data.autorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['texto', 'fixada', 'editadoEm'])
          && request.resource.data.editadoEm == request.time
          && textoDaAnotacao(request.resource.data);

        allow delete: if false;
      }
    }

    match /professionals/{professionalId} {
      // A família não usa o cadastro dos profissionais (CPF, repasse): só gestão e terapeutas
      allow read: if canManage() || isProfissional();
      allow write: if isAdmin() || isCoordenador();
    }

    match /specialties/{specialtyId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    match /rooms/{roomId} {
      allow read: if isApproved();
      allow write: if canManage();
    }

    match /appointments/{appointmentId} {
      // Gestão e terapeutas veem a agenda da clínica; a família, só os atendimentos das suas crianças
      allow read: if canManage() || isProfissional() || (
        isFamiliar()
        && get(/databases/$(database)/documents/patients/$(resource.data.patientId)).data.userId == request.auth.uid
      );
      // Só a recepção e a gestão criam, alteram e apagam atendimentos (o terapeuta consulta)
      allow create, delete: if canManage();
      // A única exceção: o terapeuta da sessão põe ou tira a marca da evolução dela (sem o texto)
      allow update: if canManage() || (
        isApproved()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['evolucao'])
        && get(/databases/$(database)/documents/professionals/$(resource.data.professionalId)).data.userId == request.auth.uid
        && marcaBateComEvolucao(appointmentId, resource.data.patientId)
      );
    }

    match /comercial_eventos/{eventoId} {
      allow list, get: if isComercialTeam();
      allow create, update, delete: if isComercialTeam();
    }

    match /comercial_leads/{leadId} {
      allow list, get: if isComercialTeam();
      allow create, update, delete: if isComercialTeam();
    }

    // Financeiro: só o admin. A recepção e a coordenação apenas geram o repasse ao finalizar um
    // atendimento: o lançamento, o plano de contas e o centro de custo dele, e a conta padrão.
    match /transactions/{docId} {
      allow read: if isAdmin() || (canManage() && isRepasse(resource.data));
      allow create: if isAdmin() || (
        canManage() && isRepasse(request.resource.data) && request.resource.data.appointmentId is string
      );
      allow update: if isAdmin();
      // Repasse já pago não se apaga: o registro do pagamento é do Financeiro
      allow delete: if isAdmin() || (
        canManage() && isRepasse(resource.data) && resource.data.status == 'pendente'
      );
    }
    match /accountPlans/{docId} {
      allow read: if isAdmin() || (canManage() && resource.data.name == 'Repasse de Profissional');
      allow create: if isAdmin() || (canManage() && request.resource.data.name == 'Repasse de Profissional');
      allow update, delete: if isAdmin();
    }
    match /costCenters/{docId} {
      // São os nomes das terapias; o repasse cria o que faltar
      allow read, create: if canManage();
      allow update, delete: if isAdmin();
    }
    match /bankAccounts/{docId} {
      allow read: if isAdmin() || (canManage() && resource.data.isDefault == true);
      allow write: if isAdmin();
    }
    match /settings/{docId} { allow read, write: if isAdmin(); }
    match /suppliers/{docId} { allow read, write: if isAdmin(); }
    match /covenants/{docId} { allow read, write: if isAdmin(); }
    match /budgets/{docId} { allow read, write: if isAdmin(); }

    // Avisos (lib/avisos.ts): a gestão vê todos; terapeutas, os da equipe e os dos terapeutas
    // ("profissional" são os avisos internos antigos); famílias, os das famílias.
    // Assistente de agendamento: a coordenação escolhe ou recusa opções de encaixe, a recepção agenda.
    // Só a gestão. Quem cria assina em seu nome; depois, só se marca o que foi agendado.
    match /encaixes/{encaixeId} {
      allow read, delete: if canManage();
      allow create: if canManage()
        && request.resource.data.status in ['para_agendar', 'recusado']
        && request.resource.data.criadoPor.uid == request.auth.uid;
      allow update: if canManage()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['agendadas', 'status', 'agendadoEm'])
        && resource.data.status in ['para_agendar', 'agendado']
        && request.resource.data.status in ['para_agendar', 'agendado'];
    }

    match /communications/{communicationId} {
      function podeLerAviso(aviso) {
        return canManage()
          || (isProfissional() && aviso.targetRole in ['equipe', 'terapeutas', 'profissional'])
          || (isFamiliar() && aviso.targetRole == 'familiar');
      }

      // Editar e excluir: quem escreveu, a administração e a coordenação
      function podeMexerNoAviso() {
        return isAdmin() || isCoordenador() || (canManage() && resource.data.authorId == request.auth.uid);
      }

      function textoValido(dados) {
        return dados.title is string && dados.title.size() > 0 && dados.title.size() <= 200
          && dados.message is string && dados.message.size() > 0 && dados.message.size() <= 5000;
      }

      allow read: if podeLerAviso(resource.data);

      // A gestão envia em seu próprio nome, para um dos públicos da tela, e ninguém nasce lido
      allow create: if canManage()
        && request.resource.data.keys().hasOnly([
          'title', 'message', 'isImportant', 'targetRole', 'authorId', 'authorName', 'createdAt', 'readBy'
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.targetRole in ['equipe', 'terapeutas', 'coordenador', 'familiar', 'profissional']
        && request.resource.data.isImportant is bool
        && request.resource.data.readBy == {}
        && textoValido(request.resource.data);

      allow update: if (
        // Confirmar a leitura: cada um marca só a própria, nos avisos que pode ler
        podeLerAviso(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && request.resource.data.readBy.diff(resource.data.readBy).affectedKeys().hasOnly([request.auth.uid])
      ) || (
        // Editar: só o título e o texto
        podeMexerNoAviso()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'message'])
        && textoValido(request.resource.data)
      );

      allow delete: if podeMexerNoAviso();
    }
  }
}
