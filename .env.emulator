# Configuração para rodar o app e os testes contra o emulador local do Firebase.
# Não contém segredos: o projeto "demo-libelle" só existe no emulador.
# As variáveis daqui têm prioridade sobre o .env.local (produção).

NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-libelle.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-libelle
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-libelle.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo

# Faz o firebase-admin (rotas /api) usar o emulador em vez da nuvem.
FIREBASE_PROJECT_ID=demo-libelle
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
